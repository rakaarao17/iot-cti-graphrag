# IoT Threat Intelligence GraphRAG Configuration
# Copy this file to .env and fill in your values
# Note: .env is NOT tracked in git (see .gitignore)

# ============================================
# Neo4j Graph Database Configuration
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_POOL_SIZE=20
NEO4J_MAX_RETRIES=3

# ============================================
# Ollama LLM Service Configuration
# ============================================
# Ollama must be running locally: ollama serve
OLLAMA_API_URL=http://localhost:11434/api
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:e2b
# Pull the model first with: ollama pull gemma4:e2b
# Other local options that have been used: phi3, zeroday-phi3-ciciot-v2

# ============================================
# Text Embeddings (local, no API key required)
# ============================================
# The core pipeline uses a local sentence-transformers model:
#   all-MiniLM-L6-v2 (384-dim). It downloads ~90MB on first run, then runs offline.
# No configuration needed for the default setup.

# ============================================
# Google API (OPTIONAL / legacy)
# ============================================
# Not used by the core pipeline. Only referenced by a few optional helper
# scripts (scripts/quick_embed_meta.py, scripts/setup_neo4j.py). Leave blank
# unless you are running those specific scripts.
# GOOGLE_API_KEY=

# ============================================
# Data Paths (optional, defaults provided)
# ============================================
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed
# DATA_SAMPLES_DIR=data/samples
# RESULTS_DIR=results

# ============================================
# Application Configuration
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# LLM Parameters
# ============================================
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=300
